# Copy to deploy/.env and adjust. Safe local defaults; no secrets committed (CLAUDE.md "Config").

# Postgres superuser (per-service roles/dbs are created by postgres-init/).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Per-service DB passwords (default to the service name in dev).
CUSTOMER_DB_PASSWORD=customer

# Keycloak bootstrap admin.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Grafana admin (anonymous admin is also enabled for local convenience).
GRAFANA_PASSWORD=admin
