<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.lms</groupId>
    <artifactId>lms-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>decision</artifactId>
  <name>Micro-Loan LMS :: Service :: Decision</name>
  <description>Reference hexagonal service: decision registration with outbox-published events.</description>

  <properties>
    <jib.version>3.4.4</jib.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.lms</groupId>
      <artifactId>contracts</artifactId>
    </dependency>
    <dependency>
      <groupId>com.lms</groupId>
      <artifactId>lms-money</artifactId>
    </dependency>
    <dependency>
      <groupId>com.lms</groupId>
      <artifactId>lms-schedule</artifactId>
    </dependency>
    <dependency>
      <!-- Parallel bureau/bank fan-out via Fanout.callAll. lms-concurrency is preview-compiled,
           so the test JVM enables preview features (see argLine below and ADR 0006). -->
      <groupId>com.lms</groupId>
      <artifactId>lms-concurrency</artifactId>
    </dependency>
    <dependency>
      <groupId>com.lms</groupId>
      <artifactId>lms-events</artifactId>
    </dependency>
    <dependency>
      <groupId>com.lms</groupId>
      <artifactId>lms-outbox</artifactId>
    </dependency>
    <dependency>
      <groupId>com.lms</groupId>
      <artifactId>lms-security</artifactId>
    </dependency>
    <dependency>
      <groupId>com.lms</groupId>
      <artifactId>lms-observability</artifactId>
    </dependency>
    <dependency>
      <groupId>com.lms</groupId>
      <artifactId>lms-config</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>io.confluent</groupId>
      <artifactId>kafka-avro-serializer</artifactId>
    </dependency>
    <dependency>
      <!-- Resilience4j core libs (programmatic; the Boot-4 starter is an open risk, ADR 0001). -->
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-retry</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-circuitbreaker</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-timelimiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>jcl-over-slf4j</artifactId>
    </dependency>

    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>com.lms</groupId>
      <artifactId>lms-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- javac must load the preview-marked Fanout.class, so this module enables preview at
           compile time too (ADR 0006); its own classes are then preview-flagged, matching the
           runtime/test preview flag. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${maven.compiler.release}</release>
          <compilerArgs>
            <arg>--enable-preview</arg>
            <arg>-parameters</arg>
            <arg>-Xlint:all,-preview,-processing</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <!-- Avro 1.12 trusted packages for serde in unit tests (ADR 0004). The runtime preview flag
           is required because this service loads the preview-compiled lms-concurrency Fanout
           (ADR 0006); @{argLine} preserves the JaCoCo agent. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@{argLine} --enable-preview</argLine>
          <systemPropertyVariables>
            <org.apache.avro.SERIALIZABLE_PACKAGES>com.lms.contracts</org.apache.avro.SERIALIZABLE_PACKAGES>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <argLine>@{argLine} --enable-preview</argLine>
          <systemPropertyVariables>
            <org.apache.avro.SERIALIZABLE_PACKAGES>com.lms.contracts</org.apache.avro.SERIALIZABLE_PACKAGES>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <!-- Infra that needs Postgres/Kafka or is pure wiring is covered by ITs (deferred to Docker). -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>com/lms/decision/DecisionApplication*</exclude>
            <exclude>com/lms/decision/config/*</exclude>
            <exclude>com/lms/decision/adapters/out/persistence/*</exclude>
            <exclude>com/lms/decision/adapters/out/events/*</exclude>
            <exclude>com/lms/decision/adapters/out/http/*</exclude>
            <exclude>com/lms/decision/adapters/in/**</exclude>
          </excludes>
        </configuration>
      </plugin>

      <!-- Non-root container image via Jib (not bound to a phase; run with `mvn jib:dockerBuild`). -->
      <plugin>
        <groupId>com.google.cloud.tools</groupId>
        <artifactId>jib-maven-plugin</artifactId>
        <version>${jib.version}</version>
        <configuration>
          <from>
            <image>eclipse-temurin:25-jre</image>
          </from>
          <to>
            <image>lms/decision:${project.version}</image>
          </to>
          <container>
            <user>1000:1000</user>
            <ports>
              <port>8103</port>
            </ports>
            <jvmFlags>
              <jvmFlag>-XX:MaxRAMPercentage=75</jvmFlag>
              <jvmFlag>-Dorg.apache.avro.SERIALIZABLE_PACKAGES=com.lms.contracts</jvmFlag>
            </jvmFlags>
          </container>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
