<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared JSON console logging. Services activate it with
  logging.config=classpath:logback-json.xml (or set logging.structured.format.console).
  Every line carries traceId from the RequestContext ScopedValue (CLAUDE.md "Logging").
  loanId is added by the loan-account service once loans exist (Phase 1).
-->
<included>
  <conversionRule conversionWord="rctx"
                  converterClass="com.lms.observability.logging.RequestContextConverter"/>

  <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="ch.qos.logback.classic.encoder.JsonEncoder"/>
  </appender>

  <!-- Plain pattern variant that guarantees traceId presence for pattern-based setups. -->
  <appender name="JSON_PATTERN" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>{"ts":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}","level":"%level","logger":"%logger{40}","traceId":"%rctx{traceId}","thread":"%thread","msg":"%replace(%msg){'\"','\\\"'}"}%n</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="JSON_PATTERN"/>
  </root>
</included>
