{
  "type": "record",
  "name": "LoanInterestAccrued",
  "namespace": "com.lms.contracts.loan",
  "doc": "Published on loan.events once per (loanId, businessDate) by the daily interest accrual job (docs/domain-rules.md 'Interest and penal accrual'). Ledger posts debit Interest Receivable / credit Interest Income.",
  "fields": [
    { "name": "metadata", "type": "com.lms.contracts.events.EventMetadata" },
    { "name": "loanId", "type": "string" },
    {
      "name": "businessDate",
      "type": { "type": "int", "logicalType": "date" },
      "doc": "The business date the interest was recognised for"
    },
    { "name": "amount", "type": "com.lms.contracts.events.MoneyAmount", "doc": "Interest recognised on this day" },
    { "name": "instalmentNumber", "type": "int", "doc": "Instalment period this day belongs to" },
    {
      "name": "accruedAt",
      "type": { "type": "long", "logicalType": "timestamp-millis" }
    }
  ]
}
