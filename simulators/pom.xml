<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.lms</groupId>
    <artifactId>lms-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>simulators</artifactId>
  <name>Micro-Loan LMS :: Simulators</name>
  <description>
    Owned mocks for every external party (bureau, KYC, bank, SMS) with a control API for latency,
    failure, timeout, duplicate-callback and seed. In-memory; never a system of record.
  </description>

  <properties>
    <jib.version>3.4.4</jib.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>jcl-over-slf4j</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>com.lms</groupId>
      <artifactId>lms-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Test-only: cross-verify the simulators' SimCallbackSigner against lms-security's
         CallbackVerifier so the two signing implementations cannot drift. Kept off the runtime
         classpath so Spring Security does not lock down these open mock endpoints. -->
    <dependency>
      <groupId>com.lms</groupId>
      <artifactId>lms-security</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- Pure wiring (controllers/config) is exercised by MockMvc slice tests; the HTTP callback
           client and the app bootstrap need a running peer and are covered in the Docker session. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>com/lms/simulators/SimulatorsApplication*</exclude>
            <exclude>com/lms/simulators/config/SimulatorsConfig*</exclude>
            <exclude>com/lms/simulators/kyc/HttpKycCallbackClient*</exclude>
            <exclude>com/lms/simulators/callback/HttpSignedCallbackClient*</exclude>
          </excludes>
        </configuration>
      </plugin>

      <plugin>
        <groupId>com.google.cloud.tools</groupId>
        <artifactId>jib-maven-plugin</artifactId>
        <version>${jib.version}</version>
        <configuration>
          <from>
            <image>eclipse-temurin:25-jre</image>
          </from>
          <to>
            <image>lms/simulators:${project.version}</image>
          </to>
          <container>
            <user>1000:1000</user>
            <ports>
              <port>8190</port>
            </ports>
            <jvmFlags>
              <jvmFlag>-XX:MaxRAMPercentage=75</jvmFlag>
            </jvmFlags>
          </container>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
