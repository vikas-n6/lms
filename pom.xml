<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.lms</groupId>
  <artifactId>lms-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Micro-Loan LMS :: Parent</name>
  <description>Parent aggregator and dependency/plugin management for the micro-loan LMS.</description>

  <!--
    Versions resolved from authoritative maven-metadata.xml on 2026-10-11.
    See docs/adr/0001-versions.md. Service POMs must contain NO version numbers;
    everything is managed here or in the imported BOMs.
  -->
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <java.version>25</java.version>

    <!-- Versions NOT governed by the Spring Boot BOM -->
    <spring-boot.version>4.1.1</spring-boot.version>
    <spring-framework.version>7.0.9</spring-framework.version>
    <temporal.version>1.40.0</temporal.version>
    <avro.version>1.12.2</avro.version>
    <confluent.version>8.3.2</confluent.version>
    <kafka.version>4.3.1</kafka.version>
    <jooq.version>3.21.9</jooq.version>
    <redisson.version>4.8.0</redisson.version>
    <resilience4j.version>2.4.0</resilience4j.version>
    <spring-cloud.version>2025.1.3</spring-cloud.version>
    <testcontainers.version>2.0.5</testcontainers.version>
    <jqwik.version>1.10.2</jqwik.version>
    <archunit.version>1.5.1</archunit.version>

    <!-- Plugin versions -->
    <spotless.version>3.10.4</spotless.version>
    <google-java-format.version>1.37.0</google-java-format.version>
    <jacoco.version>0.8.13</jacoco.version>
    <enforcer.version>3.5.0</enforcer.version>
    <surefire.version>3.5.2</surefire.version>
    <compiler-plugin.version>3.14.0</compiler-plugin.version>
    <avro-plugin.version>${avro.version}</avro-plugin.version>
    <frontend-plugin.version>1.15.1</frontend-plugin.version>

    <!-- Coverage gate: overridden to 0.90 in lms-money and the schedule engine -->
    <coverage.line.min>0.70</coverage.line.min>
  </properties>

  <!-- Confluent repo for the Schema Registry client and Avro serializer (ADR 0001). -->
  <repositories>
    <repository>
      <id>confluent</id>
      <url>https://packages.confluent.io/maven/</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>

  <modules>
    <module>lms-bom</module>
    <module>platform/lms-money</module>
    <module>platform/lms-schedule</module>
    <module>platform/lms-concurrency</module>
    <module>platform/lms-config</module>
    <module>platform/lms-events</module>
    <module>platform/lms-security</module>
    <module>platform/lms-observability</module>
    <module>platform/lms-outbox</module>
    <module>platform/lms-testkit</module>
    <module>contracts</module>
    <module>services/customer</module>
    <module>services/gateway</module>
    <module>services/origination</module>
    <module>services/decision</module>
    <module>services/loan-account</module>
    <module>services/ledger</module>
    <module>services/notification</module>
    <module>simulators</module>
    <module>services/disbursement</module>
  <module>services/repayment</module>
  <module>services/collections</module>
  <module>services/reporting</module>
</modules>

  <dependencyManagement>
    <dependencies>
      <!-- Internal platform BOM: manages every com.lms platform module version -->
      <dependency>
        <groupId>com.lms</groupId>
        <artifactId>lms-bom</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Spring Boot (and Spring Framework 7, Jackson, JUnit, etc.) -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!--
        Spring 7 reintroduced a hard dependency from spring-core onto the banned
        commons-logging (ADR 0003). Managing spring-core here with the exclusion removes it from
        every transitive path, so individual Spring dependencies need no per-artifact exclusion.
        Version tracks the Boot-managed Spring Framework release (${spring-framework.version}).
      -->
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-core</artifactId>
        <version>${spring-framework.version}</version>
        <exclusions>
          <exclusion>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
          </exclusion>
        </exclusions>
      </dependency>

      <!-- Testcontainers BOM -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Spring Cloud (gateway). Oakwood 2025.1.x supports Spring Boot 4.1 (ADR 0001). -->
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Resilience4j BOM -->
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-bom</artifactId>
        <version>${resilience4j.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- jqwik (property-based testing); no BOM is published, so manage the aggregator directly -->
      <dependency>
        <groupId>net.jqwik</groupId>
        <artifactId>jqwik</artifactId>
        <version>${jqwik.version}</version>
      </dependency>

      <!-- Avro -->
      <dependency>
        <groupId>org.apache.avro</groupId>
        <artifactId>avro</artifactId>
        <version>${avro.version}</version>
      </dependency>

      <!-- Convergence pin: Avro 1.12.2 and Confluent 8.3.2 disagree on commons-compress -->
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-compress</artifactId>
        <version>1.28.0</version>
      </dependency>
      <!-- Convergence pin: guava (via Confluent) vs postgresql disagree on checker-qual -->
      <dependency>
        <groupId>org.checkerframework</groupId>
        <artifactId>checker-qual</artifactId>
        <version>3.55.1</version>
      </dependency>
      <!-- Convergence pins for Temporal's gRPC/protobuf/gson/guava chains (ADR 0008):
           error_prone_annotations (2.18.0 / 2.41.0 / 2.50.0) and guava (33.4.8/33.6.0,
           -android vs -jre). Pin the highest, -jre flavour for the server JVM. -->
      <dependency>
        <groupId>com.google.errorprone</groupId>
        <artifactId>error_prone_annotations</artifactId>
        <version>2.50.0</version>
      </dependency>
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>33.6.0-jre</version>
      </dependency>

      <!-- Kafka clients pinned to 4.x (KRaft), overriding the Boot-managed version (ADR 0001) -->
      <dependency>
        <groupId>org.apache.kafka</groupId>
        <artifactId>kafka-clients</artifactId>
        <version>${kafka.version}</version>
      </dependency>

      <!-- Confluent Avro serde + Schema Registry client -->
      <dependency>
        <groupId>io.confluent</groupId>
        <artifactId>kafka-avro-serializer</artifactId>
        <version>${confluent.version}</version>
      </dependency>
      <dependency>
        <groupId>io.confluent</groupId>
        <artifactId>kafka-schema-registry-client</artifactId>
        <version>${confluent.version}</version>
      </dependency>

      <!-- Temporal -->
      <dependency>
        <groupId>io.temporal</groupId>
        <artifactId>temporal-sdk</artifactId>
        <version>${temporal.version}</version>
      </dependency>
      <dependency>
        <groupId>io.temporal</groupId>
        <artifactId>temporal-testing</artifactId>
        <version>${temporal.version}</version>
      </dependency>

      <!-- jOOQ (ledger + money paths) -->
      <dependency>
        <groupId>org.jooq</groupId>
        <artifactId>jooq</artifactId>
        <version>${jooq.version}</version>
      </dependency>

      <!-- Redisson (locks) -->
      <dependency>
        <groupId>org.redisson</groupId>
        <artifactId>redisson</artifactId>
        <version>${redisson.version}</version>
      </dependency>

      <!-- ArchUnit -->
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler-plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <compilerArgs>
              <arg>-Xlint:all,-preview,-processing</arg>
            </compilerArgs>
          </configuration>
        </plugin>

        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <configuration>
            <java>
              <!-- Version omitted on purpose: let Spotless use the google-java-format it was
                   built and tested against, which tracks current JDKs (JDK 25 here). -->
              <googleJavaFormat>
                <style>AOSP</style>
              </googleJavaFormat>
              <removeUnusedImports/>
              <trimTrailingWhitespace/>
              <endWithNewline/>
            </java>
          </configuration>
          <executions>
            <execution>
              <id>spotless-check</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
          <executions>
            <execution>
              <id>jacoco-prepare</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>jacoco-report</id>
              <phase>verify</phase>
              <goals>
                <goal>report</goal>
              </goals>
            </execution>
            <execution>
              <id>jacoco-check</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
              <configuration>
                <rules>
                  <rule>
                    <element>BUNDLE</element>
                    <limits>
                      <limit>
                        <counter>LINE</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>${coverage.line.min}</minimum>
                      </limit>
                    </limits>
                  </rule>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
          <configuration>
            <includes>
              <include>**/*Test.java</include>
            </includes>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${surefire.version}</version>
          <configuration>
            <includes>
              <include>**/*IT.java</include>
            </includes>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${enforcer.version}</version>
        <executions>
          <execution>
            <id>enforce-rules</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <dependencyConvergence/>
                <banDuplicatePomDependencyVersions/>
                <bannedDependencies>
                  <excludes>
                    <exclude>commons-logging:commons-logging</exclude>
                    <exclude>log4j:log4j</exclude>
                    <exclude>org.hibernate:*</exclude>
                    <exclude>org.hibernate.orm:*</exclude>
                    <exclude>org.projectlombok:lombok</exclude>
                    <exclude>javax.persistence:*</exclude>
                    <exclude>javax.servlet:*</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Spotless and JaCoCo are active in every module (declared in pluginManagement) -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- The Admin UI runs npm via frontend-maven-plugin; opt in with -Pui to keep the default
         backend build fast and offline. CI builds it with `./mvnw -Pui verify`. -->
    <profile>
      <id>ui</id>
      <modules>
        <module>admin-ui</module>
        <module>services/disbursement</module>
  <module>services/repayment</module>
</modules>
    </profile>
  </profiles>
</project>
